{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/photos/$1"
    },
    {
      "src": "/(studio-.*\\.jpg)",
      "dest": "/$1"
    },
    {
      "src": "/logo.jpg",
      "dest": "/logo.jpg"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/fine-line-tattoo-mallorca",
      "dest": "/fine-line-tattoo-mallorca.html"
    },
    {
      "src": "/tattoo-studio-south-mallorca",
      "dest": "/tattoo-studio-south-mallorca.html"
    },
    {
      "src": "/tatouage-majorque",
      "dest": "/tatouage-majorque.html"
    },
    {
      "src": "/tattoo-mallorca-urlaub",
      "dest": "/tattoo-mallorca-urlaub.html"
    },
    {
      "src": "/realism-tattoo-mallorca",
      "dest": "/realism-tattoo-mallorca.html"
    },
    {
      "src": "/confirmation",
      "dest": "/confirmation.html"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/favicon-32x32.png",
      "dest": "/favicon-32x32.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}